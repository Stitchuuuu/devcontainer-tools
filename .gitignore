# DevContainer (v2) — root-scope

# Claude — local runtime artefacts (root-only; templates/v2/.claude/ stays tracked)
# Note : `/.claude/*` (wildcard) rather than `/.claude/` so the counter-exclusion
# below actually works — git can't un-ignore content inside a fully-ignored dir.
/.claude/*
!/.claude/settings.local.json.example

# VS Code — bind-mount via docker-compose, single tracked file
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Notify queue + floating-perms — runtime artefacts (state, audit, locks, per-session queues)
.devcontainer/notify/queue/
.devcontainer/notify/floating-perms-state.json
.devcontainer/notify/floating-perms-state.json.lock
.devcontainer/notify/floating-perms-audit.jsonl

# sync-skills — timestamped backups of ~/.claude/settings.json (one per run with changes)
.devcontainer/claude/settings-backups/

# Build / OS
.env.dev
.DS_Store
vendor/anthropic.claude-code/
