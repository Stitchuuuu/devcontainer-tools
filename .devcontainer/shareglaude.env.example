# Copy to shareglaude.env (gitignored) and fill in the two URLs.
# Consumed by `wtf token share dev|prod`. See apps/shareglaude/README.md.

# Dev deployment — the workers.dev URL printed by `wtf deploy` on the host.
# Values are read literally: no shell expansion, no quotes needed.
SHAREGLAUDE_URL_DEV=https://REPLACE-ME.workers.dev

# Prod deployment — the custom domain declared in wrangler.prod.toml.
# Leave empty until that deployment exists; `wtf token share prod` will say so.
SHAREGLAUDE_URL_PROD=

# Shared secret gating POST /new. Must match the CREATE_KEY secret set on the
# Worker (`wtf secret CREATE_KEY`). Leave empty if the Worker has none.
SHAREGLAUDE_KEY=
