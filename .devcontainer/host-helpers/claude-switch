#!/usr/bin/env bash
# Switch the devcontainer's Claude Code between Anthropic cloud (default) and
# two local backends (raw Ollama / UniClaudeProxy sidecar).
#
# Three modes :
#   local       → http://ollama.internal:11434   (direct Ollama, raw — no
#                 thinking translation ; non-reasoning models or debug)
#   local-proxy → http://claude-bridge:9223      (via UniClaudeProxy sidecar,
#                 translates <think> blocks → Anthropic format ; default for
#                 reasoning models like qwen3, deepseek-r1)
#   cloud       → api.anthropic.com              (default Anthropic SDK route)
#
# A 4th URL `http://claude-bridge.local:9223` is the `.local`-NO_PROXY bypass
# alias for the sidecar (debug only — kill-switch for mitm). It's NEVER
# toggled by this script — manual `.env` edit, same as `ollama.local`.
#
# When to use this :
# - You want the in-container Claude Code (CLI + VSCode extension) to talk
#   to one of the local backends instead of api.anthropic.com — or back.
# - This runs on the HOST on purpose : the container has no business
#   modifying its own outbound routing. Editing the .env from outside keeps
#   the threat boundary clean — a compromised in-container process can't
#   silently flip the LLM endpoint.
#
# What it does :
# 1. Value-discriminated sed-toggle of the right ANTHROPIC_BASE_URL line in
#    .devcontainer/.env (each mode has its own URL line — the helper
#    decomments one and recomments the others).
# 2. Prefix-toggle of the 4 shared vars (ANTHROPIC_AUTH_TOKEN,
#    CLAUDE_CONFIG_DIR, ANTHROPIC_MODEL, ANTHROPIC_SMALL_FAST_MODEL).
#    The two MODEL vars force Claude Code to request a single model name
#    (claude-opus-4-7) for both main and small-fast calls — keeps Ollama at
#    one loaded model and the UI transparent.
# 3. Repoints <project>/CLAUDE.md to either CLAUDE-local-dev.md (local or
#    local-proxy) or CLAUDE-dev.md (cloud — or whatever
#    .configured-claude-mode names).
# 4. For `local-proxy` : checks the `claude-bridge` sidecar container state
#    (running ? healthy ?) and auto-runs `docker compose up -d claude-bridge`
#    if it's not started yet.
# 5. Reminds you to Rebuild Container in VSCode (env_file is read at
#    container creation only — Reload Window is NOT enough).
#
# Usage :
#   [host] bash .devcontainer/host-helpers/claude-switch {local|local-proxy|cloud|status}
#
# Setup + caveats : .devcontainer/knowledge/ollama-local.md
set -euo pipefail

if [ -f /.dockerenv ] || [ -n "${REMOTE_CONTAINERS:-}" ]; then
  echo "ERROR: This script must run on the host, not inside the container." >&2
  echo "       Open a terminal on your Mac/Linux host, cd to the project, and run :" >&2
  echo "       bash .devcontainer/host-helpers/claude-switch ${1:-status}" >&2
  exit 2
fi

# === URL constants — one per local mode ====================================
# Each constant matches a template line in .devcontainer/.env.example. The
# sed-toggle in toggle_base_url() targets these literal strings, so renaming
# requires updating the .env.example AND this file in lockstep.
URL_LOCAL="http://ollama.internal:11434"
URL_LOCAL_PROXY="http://claude-bridge:9223"
URL_LOCAL_PROXY_BYPASS="http://claude-bridge.local:9223"

COMPOSE_FILE="$(cd "$(dirname "$0")/.." && pwd)/docker-compose.yml"

DEVCONTAINER_DIR="$(cd "$(dirname "$0")/.." && pwd)"
PROJECT_DIR="$(cd "$DEVCONTAINER_DIR/.." && pwd)"
ENV_FILE="$DEVCONTAINER_DIR/.env"
MODE_FLAG="$DEVCONTAINER_DIR/.configured-claude-mode"
CLAUDE_MD="$PROJECT_DIR/CLAUDE.md"

if [ ! -f "$ENV_FILE" ]; then
  echo "ERROR: $ENV_FILE not found — run initialize.sh first." >&2
  exit 2
fi

# Portable in-place sed (BSD on macOS, GNU on Linux) — write to temp + mv.
sed_inplace() {
  local expr=$1 file=$2 tmp
  tmp=$(mktemp "${file}.XXXXXX")
  sed -E "$expr" "$file" > "$tmp" && mv "$tmp" "$file"
}

# Regex-escape an ERE pattern in pure bash (no sed). The character class
# `[][.*+?^$(){}|]` works on GNU sed but BSD sed (macOS default) parses
# `[]` as an empty class and errors with "unbalanced brackets". Walking
# the string char-by-char sidesteps the BSD/GNU sed class divergence.
escape_ere() {
  local s=$1 out= c i
  for (( i=0; i<${#s}; i++ )); do
    c=${s:i:1}
    case $c in
      \\|.|\*|+|\?|\^|\$|\(|\)|\[|\]|\{|\}|\|) out+="\\$c" ;;
      *) out+=$c ;;
    esac
  done
  printf '%s' "$out"
}

# Value-discriminated comment/decomment of an `ANTHROPIC_BASE_URL=<url>` line.
# The current .env has three such lines (one per local mode) — a plain prefix
# toggle would flip all three. This targets a specific URL value with `|` as
# sed delimiter (avoids `/` escaping in URLs) and regex-escapes the URL so
# the `.` characters match literally.
#
# Usage : toggle_base_url {comment|decomment} <url> <file>
toggle_base_url() {
  local action=$1 url=$2 file=$3
  local re_url
  re_url=$(escape_ere "$url")
  case "$action" in
    decomment) sed_inplace "s|^# *(ANTHROPIC_BASE_URL=${re_url})\$|\1|" "$file" ;;
    comment)   sed_inplace "s|^(ANTHROPIC_BASE_URL=${re_url})\$|# \1|" "$file" ;;
    *) echo "ERROR: toggle_base_url action must be comment|decomment (got: $action)" >&2; exit 4 ;;
  esac
}

# Check if a specific ANTHROPIC_BASE_URL=<url> line is currently active
# (uncommented). Returns 0 if active, 1 otherwise. Same regex-escape as
# toggle_base_url so URLs with `.` match literally.
base_url_active() {
  local url=$1 file=$2
  local re_url
  re_url=$(escape_ere "$url")
  grep -qE "^ANTHROPIC_BASE_URL=${re_url}\$" "$file"
}

# Sidecar lifecycle check + auto-start for mode `local-proxy`. Reports the
# container state and starts it in the background if absent. Safe to call
# even when Docker isn't on PATH (degrades to a warning).
ensure_sidecar_running() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "    sidecar         : ⚠ docker not on PATH — install Docker Desktop or start it"
    return 0
  fi
  if [ ! -f "$COMPOSE_FILE" ]; then
    echo "    sidecar         : ⚠ $COMPOSE_FILE not found — skipping"
    return 0
  fi
  local cid
  cid=$(docker compose -f "$COMPOSE_FILE" ps -q claude-bridge 2>/dev/null || true)
  if [ -z "$cid" ]; then
    echo "    sidecar         : starting (first-boot pip install ~30-60s)…"
    docker compose -f "$COMPOSE_FILE" up -d claude-bridge >/dev/null 2>&1 &
    return 0
  fi
  local health
  health=$(docker inspect -f '{{.State.Health.Status}}' "$cid" 2>/dev/null || echo "no-healthcheck")
  case "$health" in
    healthy)
      echo "    sidecar         : already running and healthy ✓" ;;
    starting)
      echo "    sidecar         : running, healthcheck pending (start_period 90s)" ;;
    unhealthy)
      echo "    sidecar         : ⚠ container exists but unhealthy — check 'docker compose logs claude-bridge'" ;;
    *)
      echo "    sidecar         : running (healthcheck state: $health)" ;;
  esac
}

# Crash loudly if a template line is missing — sed_inplace is a silent no-op
# when the pattern doesn't match, which would leave the mode half-applied
# (e.g. base URL flipped but model name not forced → Ollama loads 2 models).
# Fix path : copy the commented line back from .env.example and re-run.
require_env_line() {
  local key=$1 file=$2
  if ! grep -qE "^# *${key}=|^${key}=" "$file"; then
    echo "ERROR: missing template line for ${key} in ${file}" >&2
    echo "       claude-switch toggles a comment prefix — the line must exist (commented or active)." >&2
    echo "       Restore from $(dirname "$file")/.env.example, then re-run :" >&2
    echo "         grep -E '^#? *${key}=' $(dirname "$file")/.env.example >> $file" >&2
    exit 3
  fi
}

# Stricter variant : require a specific ANTHROPIC_BASE_URL=<url> template
# line (commented or active). Used to detect a half-applied .env where one
# of the two audited URL lines was deleted — toggle_base_url would silently
# no-op without this check.
require_url_line() {
  local url=$1 file=$2
  local re_url
  re_url=$(escape_ere "$url")
  if ! grep -qE "^#? *ANTHROPIC_BASE_URL=${re_url}\$" "$file"; then
    echo "ERROR: missing ANTHROPIC_BASE_URL=${url} template line in ${file}" >&2
    echo "       Each local mode has its own URL line (one per mode). Restore from .env.example :" >&2
    echo "         grep -E '^#? *ANTHROPIC_BASE_URL=${url}' $(dirname "$file")/.env.example >> $file" >&2
    exit 3
  fi
}

# Keys whose comment prefix is shared across both local modes (decommented
# for `local` or `local-proxy`, recommented for `cloud`). ANTHROPIC_BASE_URL
# is handled separately by toggle_base_url because it has multiple template
# lines (one per mode) — a plain prefix toggle would flip all of them.
REQUIRED_KEYS=(
  ANTHROPIC_AUTH_TOKEN
  CLAUDE_CONFIG_DIR
  ANTHROPIC_MODEL
  ANTHROPIC_SMALL_FAST_MODEL
)

CLOUD_CLAUDE_MD="CLAUDE-dev.md"
[ -f "$MODE_FLAG" ] && CLOUD_CLAUDE_MD=$(cat "$MODE_FLAG" 2>/dev/null | tr -d ' \t\r\n')
CLOUD_CLAUDE_MD="${CLOUD_CLAUDE_MD:-CLAUDE-dev.md}"

case "${1:-}" in
  local)
    require_url_line "$URL_LOCAL"       "$ENV_FILE"
    require_url_line "$URL_LOCAL_PROXY" "$ENV_FILE"
    for key in "${REQUIRED_KEYS[@]}"; do require_env_line "$key" "$ENV_FILE"; done
    toggle_base_url decomment "$URL_LOCAL"             "$ENV_FILE"
    toggle_base_url comment   "$URL_LOCAL_PROXY"       "$ENV_FILE"
    # Bypass alias `claude-bridge.local` is NEVER touched — manual debug.
    sed_inplace 's/^# *(ANTHROPIC_AUTH_TOKEN=)/\1/'         "$ENV_FILE"
    sed_inplace 's|^# *(CLAUDE_CONFIG_DIR=)|\1|'            "$ENV_FILE"
    sed_inplace 's/^# *(ANTHROPIC_MODEL=)/\1/'              "$ENV_FILE"
    sed_inplace 's/^# *(ANTHROPIC_SMALL_FAST_MODEL=)/\1/'   "$ENV_FILE"
    ln -sfn ".devcontainer/claude/CLAUDE-local-dev.md" "$CLAUDE_MD"
    printf '\033[1;33m✓ claude → local (direct Ollama, raw)\033[0m\n'
    echo "    base URL       : $URL_LOCAL (via mitmproxy audit)"
    echo "    config dir     : /home/node/.claude-local (isolated — cloud creds untouched)"
    echo "    model (both)   : claude-opus-4-7 (alias your real model via \`ollama cp\`)"
    echo "    project rules  : CLAUDE-local-dev.md"
    echo "    ⚠ thinking models (qwen3, deepseek-r1) will hang — use 'local-proxy' for those"
    echo
    printf '    \033[1;33mNext : VSCode → Cmd+Shift+P → \"Dev Containers: Rebuild Container\"\033[0m\n'
    echo "    Reload Window is NOT enough — docker-compose reads env_file at"
    echo "    container creation only, so PID 1 (which both VS Code Server and"
    echo "    fresh shells inherit from) keeps the old env until a full rebuild."
    echo "    Immediate without rebuild : CLAUDE.md symlink + ~/.claude-local"
    echo "    (filesystem changes, propagated via bind mount). Env vars : no."
    ;;
  local-proxy)
    require_url_line "$URL_LOCAL"       "$ENV_FILE"
    require_url_line "$URL_LOCAL_PROXY" "$ENV_FILE"
    for key in "${REQUIRED_KEYS[@]}"; do require_env_line "$key" "$ENV_FILE"; done
    toggle_base_url decomment "$URL_LOCAL_PROXY"       "$ENV_FILE"
    toggle_base_url comment   "$URL_LOCAL"             "$ENV_FILE"
    # Bypass alias `claude-bridge.local` is NEVER touched — manual debug.
    sed_inplace 's/^# *(ANTHROPIC_AUTH_TOKEN=)/\1/'         "$ENV_FILE"
    sed_inplace 's|^# *(CLAUDE_CONFIG_DIR=)|\1|'            "$ENV_FILE"
    sed_inplace 's/^# *(ANTHROPIC_MODEL=)/\1/'              "$ENV_FILE"
    sed_inplace 's/^# *(ANTHROPIC_SMALL_FAST_MODEL=)/\1/'   "$ENV_FILE"
    ln -sfn ".devcontainer/claude/CLAUDE-local-dev.md" "$CLAUDE_MD"
    printf '\033[1;33m✓ claude → local-proxy (via UniClaudeProxy sidecar)\033[0m\n'
    echo "    base URL       : $URL_LOCAL_PROXY (audited via mitmproxy + claude-bridge.yaml)"
    echo "    config dir     : /home/node/.claude-local (isolated — cloud creds untouched)"
    echo "    model (both)   : claude-opus-4-7 (alias your real model via \`ollama cp\`)"
    echo "    project rules  : CLAUDE-local-dev.md"
    ensure_sidecar_running
    echo "    bypass mitm    : edit .env → $URL_LOCAL_PROXY_BYPASS (debug only)"
    echo
    printf '    \033[1;33mNext : VSCode → Cmd+Shift+P → \"Dev Containers: Rebuild Container\"\033[0m\n'
    echo "    Reload Window is NOT enough — docker-compose reads env_file at"
    echo "    container creation only, so PID 1 (which both VS Code Server and"
    echo "    fresh shells inherit from) keeps the old env until a full rebuild."
    ;;
  cloud)
    require_url_line "$URL_LOCAL"       "$ENV_FILE"
    require_url_line "$URL_LOCAL_PROXY" "$ENV_FILE"
    for key in "${REQUIRED_KEYS[@]}"; do require_env_line "$key" "$ENV_FILE"; done
    toggle_base_url comment "$URL_LOCAL"             "$ENV_FILE"
    toggle_base_url comment "$URL_LOCAL_PROXY"       "$ENV_FILE"
    # Bypass alias stays as-is (default commented — manual debug only).
    sed_inplace 's/^(ANTHROPIC_AUTH_TOKEN=)/# \1/'          "$ENV_FILE"
    sed_inplace 's|^(CLAUDE_CONFIG_DIR=)|# \1|'             "$ENV_FILE"
    sed_inplace 's/^(ANTHROPIC_MODEL=)/# \1/'               "$ENV_FILE"
    sed_inplace 's/^(ANTHROPIC_SMALL_FAST_MODEL=)/# \1/'    "$ENV_FILE"
    ln -sfn ".devcontainer/claude/$CLOUD_CLAUDE_MD" "$CLAUDE_MD"
    printf '\033[1;32m✓ claude → cloud\033[0m\n'
    echo "    base URL       : api.anthropic.com (default)"
    echo "    config dir     : ~/.claude (default)"
    echo "    model          : (Claude Code default — opus main + haiku small)"
    echo "    project rules  : $CLOUD_CLAUDE_MD"
    echo
    printf '    \033[1;32mNext : VSCode → Cmd+Shift+P → \"Dev Containers: Rebuild Container\"\033[0m\n'
    echo "    Reload Window is NOT enough — see local mode message above."
    ;;
  status)
    # Mode detection : which (if any) ANTHROPIC_BASE_URL=<url> line is active.
    active_mode="cloud"
    active_url="(unset → cloud default)"
    if   base_url_active "$URL_LOCAL"              "$ENV_FILE"; then
      active_mode="local"
      active_url="$URL_LOCAL"
    elif base_url_active "$URL_LOCAL_PROXY"        "$ENV_FILE"; then
      active_mode="local-proxy"
      active_url="$URL_LOCAL_PROXY"
    elif base_url_active "$URL_LOCAL_PROXY_BYPASS" "$ENV_FILE"; then
      active_mode="local-proxy (bypass — mitm skipped, debug)"
      active_url="$URL_LOCAL_PROXY_BYPASS"
    fi

    cur_dir=$(grep -E '^CLAUDE_CONFIG_DIR='        "$ENV_FILE" 2>/dev/null | head -1)
    cur_model=$(grep -E '^ANTHROPIC_MODEL='        "$ENV_FILE" 2>/dev/null | head -1)
    cur_small=$(grep -E '^ANTHROPIC_SMALL_FAST_MODEL=' "$ENV_FILE" 2>/dev/null | head -1)
    cur_md=$(readlink "$CLAUDE_MD" 2>/dev/null || echo "(no symlink)")
    printf "  mode          : %s\n" "$active_mode"
    printf "  base URL      : %s\n" "$active_url"
    printf "  config dir    : %s\n" "${cur_dir:-(unset → cloud default ~/.claude)}"
    printf "  model         : %s\n" "${cur_model:-(unset → Claude Code default)}"
    printf "  small-fast    : %s\n" "${cur_small:-(unset → Claude Code default)}"
    printf "  CLAUDE.md     : %s\n" "$cur_md"

    if [ "$active_mode" = "local-proxy" ] || [ "${active_mode#local-proxy}" != "$active_mode" ]; then
      printf "  "
      ensure_sidecar_running
    fi
    ;;
  *)
    echo "usage: bash .devcontainer/host-helpers/claude-switch {local|local-proxy|cloud|status}" >&2
    exit 1
    ;;
esac
