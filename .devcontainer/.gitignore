# DevContainer (v2) — internes scoped à .devcontainer/

# Runtime artefacts (auto-generated, per-rebuild)
.env
.configured-*
logs/

# Skill scratch dirs (keep dir via .keep, ignore content)
pending/*
pr-drafts/*
research-bundles/*
scan-deps/*

!pending/.keep
!pr-drafts/.keep
!research-bundles/.keep
!scan-deps/.keep

# Firewall — local overrides, caches, test logs
firewall/domains.local.txt
firewall/policy.local.d/*
firewall/addons/__pycache__/
firewall/tests/*.log
firewall-blocks.*.log

!firewall/policy.local.d/.keep

# Skills — local personal variants (runtime copies — ignored everywhere,
# including in this repo). The source-of-truth lives committed under
# templates/v2/skills/*.local/ — see templates/v2/skills/.gitignore which
# re-includes *.local there (the parent templates/v2/.gitignore ignores them
# because it doubles as the shipped .devcontainer/.gitignore for target projects).
skills/**/*.local.skill.md
skills/**/*.local/

# claude-bridge sidecar runtime config (bootstrapped from .example.json)
claude-bridge/config.json

# Lessons — local / not-yet-generalisable (committed sibling is LESSONS.md)
LESSONS.local.md
