#!/usr/bin/env bash
# Wrapper for manual lifecycle control of the UniClaudeProxy sidecar
# (`claude-bridge` service in .devcontainer/docker-compose.yml).
#
# Daily flow does NOT need this :
# - `docker compose up` (devcontainer boot) starts the sidecar with `app`.
# - `claude-switch local-proxy` auto-checks/starts the sidecar if absent.
#
# Use this wrapper when :
# - Debugging the sidecar (tail logs, restart after editing config.json).
# - The sidecar drifted unhealthy and needs an explicit restart cycle.
# - You want to free memory by stopping the sidecar between sessions
#   without rebuilding the whole devcontainer.
#
# Why run from the HOST : same threat boundary argument as claude-switch.
# The container has no docker socket access (intentional), so this wrapper
# wraps `docker compose` invocations from the host where the docker CLI
# has the actual control plane.
#
# Usage :
#   [host] bash .devcontainer/host-helpers/claude-bridge {up|down|restart|status|logs}
#
# See .devcontainer/knowledge/ollama-local.md for the sidecar architecture
# and the mode-toggle docs ("Mode local-proxy (sidecar)").
set -euo pipefail

if [ -f /.dockerenv ] || [ -n "${REMOTE_CONTAINERS:-}" ]; then
  echo "ERROR: This script must run on the host, not inside the container." >&2
  echo "       Open a terminal on your Mac/Linux host, cd to the project, and run :" >&2
  echo "       bash .devcontainer/host-helpers/claude-bridge ${1:-status}" >&2
  exit 2
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "ERROR: docker not on PATH — claude-bridge requires Docker." >&2
  echo "       Install Docker Desktop (https://www.docker.com/products/docker-desktop)" >&2
  echo "       and ensure it is running, then re-run this command." >&2
  exit 2
fi

DEVCONTAINER_DIR="$(cd "$(dirname "$0")/.." && pwd)"
COMPOSE_FILE="$DEVCONTAINER_DIR/docker-compose.yml"
SERVICE="claude-bridge"

if [ ! -f "$COMPOSE_FILE" ]; then
  echo "ERROR: $COMPOSE_FILE not found." >&2
  exit 2
fi

dc() { docker compose -f "$COMPOSE_FILE" "$@"; }

# Poll the container's healthcheck status. Returns 0 if healthy within
# $1 seconds (default 60), 1 otherwise. Reads `.State.Health.Status` via
# docker inspect — works whether the container is starting, healthy,
# unhealthy, or has no healthcheck (which would return "" → treated as
# success since healthcheck-less = best-effort).
wait_until_healthy() {
  local deadline=$(( SECONDS + ${1:-60} ))
  local cid health
  while [ $SECONDS -lt $deadline ]; do
    cid=$(dc ps -q "$SERVICE" 2>/dev/null || true)
    if [ -n "$cid" ]; then
      health=$(docker inspect -f '{{.State.Health.Status}}' "$cid" 2>/dev/null || echo "")
      case "$health" in
        healthy) return 0 ;;
        unhealthy) return 1 ;;
        ""|"<no value>") return 0 ;;  # No healthcheck defined — assume OK.
      esac
    fi
    sleep 2
  done
  return 1
}

case "${1:-}" in
  up)
    echo "▸ Starting $SERVICE (first-boot pip install can take 30-60s)…"
    dc up -d "$SERVICE"
    if wait_until_healthy 90; then
      printf '\033[1;32m✓ %s is healthy\033[0m\n' "$SERVICE"
    else
      printf '\033[1;33m⚠ %s did not reach healthy state within 90s\033[0m\n' "$SERVICE"
      echo "    Inspect with : bash .devcontainer/host-helpers/claude-bridge logs"
      exit 1
    fi
    ;;
  down)
    # stop (NOT down) — keep the container for fast restart. Use
    # `docker compose down claude-bridge` manually if you want full removal.
    echo "▸ Stopping $SERVICE (container preserved for fast restart)…"
    dc stop "$SERVICE"
    printf '\033[1;32m✓ %s stopped\033[0m\n' "$SERVICE"
    ;;
  restart)
    echo "▸ Restarting $SERVICE…"
    dc stop "$SERVICE" 2>/dev/null || true
    dc up -d "$SERVICE"
    if wait_until_healthy 60; then
      printf '\033[1;32m✓ %s restarted and healthy\033[0m\n' "$SERVICE"
    else
      printf '\033[1;33m⚠ %s did not reach healthy state within 60s\033[0m\n' "$SERVICE"
      exit 1
    fi
    ;;
  status)
    cid=$(dc ps -q "$SERVICE" 2>/dev/null || true)
    if [ -z "$cid" ]; then
      printf '\033[1;33m✗ %s : not running\033[0m\n' "$SERVICE"
      echo "    Start with : bash .devcontainer/host-helpers/claude-bridge up"
      exit 1
    fi
    state=$(docker inspect -f '{{.State.Status}}' "$cid" 2>/dev/null || echo "?")
    health=$(docker inspect -f '{{.State.Health.Status}}' "$cid" 2>/dev/null || echo "no-healthcheck")
    started=$(docker inspect -f '{{.State.StartedAt}}' "$cid" 2>/dev/null || echo "?")
    image=$(docker inspect -f '{{.Config.Image}}' "$cid" 2>/dev/null || echo "?")
    printf "  service       : %s\n" "$SERVICE"
    printf "  container id  : %s\n" "$cid"
    printf "  image         : %s\n" "$image"
    printf "  state         : %s\n" "$state"
    printf "  health        : %s\n" "$health"
    printf "  started at    : %s\n" "$started"
    ;;
  logs)
    # -f tails ; Ctrl-C to exit. --tail=50 backfills the last 50 lines so
    # you immediately see what's happening (and any startup errors).
    dc logs --tail=50 -f "$SERVICE"
    ;;
  *)
    echo "usage: bash .devcontainer/host-helpers/claude-bridge {up|down|restart|status|logs}" >&2
    exit 1
    ;;
esac
