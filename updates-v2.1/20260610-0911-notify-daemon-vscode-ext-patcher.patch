+	local daemon_dir="$DEVCONTAINER_DIR/notify"
+	local queue_dir="$DEVCONTAINER_DIR/notify/queue"
+	local logfile="$queue_dir/daemon.log"
+	local pidfile="$queue_dir/.daemon.pid"
+
