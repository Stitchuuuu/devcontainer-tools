-	toast:   notifier,
-	sound:   sound,
-	discord: discordWebhook,
-	flash:   flashWin
+	'basic-notif': notifier,
+	notify:        notifyApp,
+	sound:         sound,
+	discord:       discordWebhook,
+	flash:         flashWin
