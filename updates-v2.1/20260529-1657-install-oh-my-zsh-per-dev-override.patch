From e03285f2aaba2655a65cd8e06f44273bd703ec43 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ke=CC=81vin=20=CA=98=E2=80=BF=CA=98?= <cmoi@kevledev.fr>
Date: Fri, 29 May 2026 16:57:38 +0000
Subject: [PATCH] feat(devcontainer): install Oh My Zsh + per-dev zsh override
 layer

Bake Oh My Zsh + zsh-autosuggestions + zsh-syntax-highlighting
into Dockerfile.base. shell-init.sh now sources a committed
zshrc-base (eastwood theme, wtf completion via bashcompinit, shared
history with dedup) for every interactive zsh, then optionally
sources a gitignored zshrc.local for per-dev overrides.
zshrc.local.example ships as the starter template.
.devcontainer/.gitignore excludes zshrc.local + .zsh-custom/.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 .devcontainer/.gitignore          |  4 +++
 .devcontainer/Dockerfile.base     | 22 +++++++++++++
 .devcontainer/shell-init.sh       | 15 +++++++++
 .devcontainer/zshrc-base          | 47 ++++++++++++++++++++++++++++
 .devcontainer/zshrc.local.example | 52 +++++++++++++++++++++++++++++++
 5 files changed, 140 insertions(+)
 create mode 100644 .devcontainer/zshrc-base
 create mode 100644 .devcontainer/zshrc.local.example

diff --git a/.devcontainer/.gitignore b/.devcontainer/.gitignore
index 58ed872..b72ae29 100644
--- a/.devcontainer/.gitignore
+++ b/.devcontainer/.gitignore
@@ -34,3 +34,7 @@ claude-bridge/config.json
 
 # Lessons — local / not-yet-generalisable (committed sibling is LESSONS.md)
 LESSONS.local.md
+
+# Per-dev zsh override + custom OMZ plugins/themes (paths from .devcontainer/)
+zshrc.local
+.zsh-custom/
diff --git a/.devcontainer/Dockerfile.base b/.devcontainer/Dockerfile.base
index 312484c..d7e6ce3 100644
--- a/.devcontainer/Dockerfile.base
+++ b/.devcontainer/Dockerfile.base
@@ -269,6 +269,28 @@ RUN chmod +x /usr/local/bin/init-firewall.sh /usr/local/bin/test-firewall.sh /us
 # Shell init
 # -----------------------------------------------
 USER $USERNAME
+
+# -----------------------------------------------
+# Oh My Zsh + extra plugins (autosuggestions, syntax-highlighting)
+# Installed under $HOME/.oh-my-zsh — volatile across container
+# rebuilds, but baked into the image so first boot is instant.
+# OMZ uses its default ZSH_CUSTOM ($ZSH/custom/) ; the two plugins
+# land at $ZSH/custom/plugins/{zsh-autosuggestions,zsh-syntax-highlighting}.
+#
+# --unattended  : OMZ installer does not spawn an interactive shell.
+# rm -f .zshrc* : the installer writes a default .zshrc — remove it
+#                 so the next RUN block (shell-init injection)
+#                 starts from an empty file.
+# --depth=1     : shallow clone for the two plugins (~1 MB combined
+#                 vs ~5-10 MB full history).
+# -----------------------------------------------
+RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended \
+ && rm -f $HOME/.zshrc $HOME/.zshrc.pre-oh-my-zsh \
+ && git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions \
+      $HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions \
+ && git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting \
+      $HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting
+
 # shell-init.sh sourced from workspace (no rebuild needed on changes)
 RUN echo '[ -f /workspace/.devcontainer/shell-init.sh ] && source /workspace/.devcontainer/shell-init.sh' >> $HOME/.bashrc && \
     echo '[ -f /workspace/.devcontainer/shell-init.sh ] && source /workspace/.devcontainer/shell-init.sh' >> $HOME/.zshrc
diff --git a/.devcontainer/shell-init.sh b/.devcontainer/shell-init.sh
index 478e45b..bc517a3 100755
--- a/.devcontainer/shell-init.sh
+++ b/.devcontainer/shell-init.sh
@@ -1,3 +1,11 @@
+# zsh-only — load Oh My Zsh + team-wide zsh base BEFORE the banner below
+# so the prompt / completion / history are initialised when the rest of
+# this file runs. Bash users skip this block cleanly.
+if [ -n "$ZSH_VERSION" ] && [[ $- == *i* ]]; then
+  [ -f /workspace/.devcontainer/zshrc-base ] && \
+    source /workspace/.devcontainer/zshrc-base
+fi
+
 # Show post-start log path on first shell
 # Sourced from .zshrc/.bashrc at container startup
 # Only run in interactive terminals
@@ -218,3 +226,10 @@ fi
 # can't silently flip the LLM endpoint. The ~/.claude-local/ isolation
 # directory is initialized by post-start.sh when local mode is detected in
 # .env at container boot.
+
+# Per-dev zsh override (gitignored, persists with the workspace) — sourced
+# LAST so it can override anything from zshrc-base or env vars set above.
+if [ -n "$ZSH_VERSION" ] && [[ $- == *i* ]] && \
+   [ -f /workspace/.devcontainer/zshrc.local ]; then
+  source /workspace/.devcontainer/zshrc.local
+fi
diff --git a/.devcontainer/zshrc-base b/.devcontainer/zshrc-base
new file mode 100644
index 0000000..91b66a4
--- /dev/null
+++ b/.devcontainer/zshrc-base
@@ -0,0 +1,47 @@
+# zshrc-base — team-wide zsh config for the devcontainer.
+# Sourced by shell-init.sh on every interactive zsh shell, BEFORE the
+# banner. Per-dev overrides go in .devcontainer/zshrc.local (gitignored,
+# sourced at the end of shell-init.sh).
+
+# Oh My Zsh framework (installed under $HOME/.oh-my-zsh at image build)
+export ZSH="$HOME/.oh-my-zsh"
+
+# Defensive : earlier revisions of this file exported ZSH_CUSTOM to a
+# workspace path. Long-lived parent processes (VSCode server) may
+# still carry the stale value in their env and pass it to forked
+# terminals. Unset it here so OMZ falls back to its default
+# ($ZSH/custom/) where the baked plugins actually live.
+unset ZSH_CUSTOM
+
+# Theme — overridable in zshrc.local (set ZSH_THEME=foo at the top of
+# zshrc.local, then re-source $ZSH/oh-my-zsh.sh OR open a new shell).
+ZSH_THEME="${ZSH_THEME:-eastwood}"
+
+# Plugins — git (built-in OMZ) + two extras baked in the image
+plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
+
+# History — share across sessions, dedupe, ignore commands starting with
+# a space, trim whitespace, ask before running !history expansions.
+HISTFILE="$HOME/.zsh_history"
+HISTSIZE=10000
+SAVEHIST=10000
+setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS HIST_VERIFY
+
+# Load OMZ (initialises compinit, prompt, plugins, git aliases)
+source "$ZSH/oh-my-zsh.sh"
+
+# wtf autocomplete — wtf is baked in the image (Dockerfile.base).
+# Generate the completion script once, then source it on every shell.
+__zshrc_base_wtf_completion="$HOME/.cache/zsh/wtf-completion.zsh"
+if [ ! -f "$__zshrc_base_wtf_completion" ] && command -v wtf >/dev/null 2>&1; then
+  mkdir -p "$HOME/.cache/zsh"
+  wtf --autocomplete setup > "$__zshrc_base_wtf_completion" 2>/dev/null
+fi
+# wtf ships a bash-style completion (`complete -F ...`). bashcompinit
+# lets zsh honour bash's `complete` builtin. Must come after OMZ
+# (which runs compinit) and before sourcing the file.
+if [ -f "$__zshrc_base_wtf_completion" ]; then
+  autoload -U +X bashcompinit && bashcompinit
+  source "$__zshrc_base_wtf_completion"
+fi
+unset __zshrc_base_wtf_completion
diff --git a/.devcontainer/zshrc.local.example b/.devcontainer/zshrc.local.example
new file mode 100644
index 0000000..5eb533a
--- /dev/null
+++ b/.devcontainer/zshrc.local.example
@@ -0,0 +1,52 @@
+# zshrc.local.example — per-dev overrides template.
+#
+# To use : copy this file to .devcontainer/zshrc.local and edit.
+# That file is gitignored, persists with the workspace across container
+# rebuilds, and is sourced AFTER zshrc-base (so you can override
+# anything set by the team baseline).
+#
+#   cp .devcontainer/zshrc.local.example .devcontainer/zshrc.local
+
+# === Change the theme ===
+# Browse themes : https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
+# The theme is set BEFORE OMZ loads by zshrc-base, so to override here
+# you need to re-load OMZ.
+#
+# ZSH_THEME="eastwood"
+# source $ZSH/oh-my-zsh.sh
+
+# === Personal aliases ===
+# alias ll='ls -al'
+# alias vi=vim
+# alias g=git
+
+# === Port helpers ===
+# alias lsport='ss -tunlp | grep '
+# killport() {
+#   local port="$1"
+#   while [ -z "$port" ]; do
+#     read -p "What port to kill? " port
+#   done
+#   fuser -k "$port/tcp"
+# }
+
+# === Per-dev plugin install (persists in .devcontainer/.zsh-custom/) ===
+# Workflow :
+#   1. Clone into $ZSH_CUSTOM (which points to .devcontainer/.zsh-custom)
+#   2. Source the plugin script here
+#
+# Example — zsh-z (autojump-like) :
+#
+# if [ ! -d "$ZSH_CUSTOM/plugins/zsh-z" ]; then
+#   git clone --depth=1 https://github.com/agkozak/zsh-z "$ZSH_CUSTOM/plugins/zsh-z"
+# fi
+# source "$ZSH_CUSTOM/plugins/zsh-z/zsh-z.plugin.zsh"
+#
+# Note : adding to plugins=() does NOT work here — OMZ is already
+# loaded by the time this file is sourced. Source the plugin file
+# directly (as above), or move the plugins= line to before OMZ loads
+# (would require editing zshrc-base, which is team-wide).
+
+# === Personal env vars ===
+# export EDITOR=vim
+# export LESS='-FRX'
-- 
