From e029f5ec06c531e7647f6f518786ea4af3eefd88 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ke=CC=81vin=20=CA=98=E2=80=BF=CA=98?= <cmoi@kevledev.fr>
Date: Wed, 10 Jun 2026 09:39:46 +0000
Subject: [PATCH] fix(devcontainer): align post-start banner widths to 64 chars
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The four boxed warnings printed by post-start.sh (Firewall BASIC,
Claude binary fallback, Claude Code update, Project manifests stale)
had drifted to inner widths of 64 / 64 / 56 / 62 — visible as a
staircase when two or more stacked at boot. Standardize on 64 chars
(the floor — Firewall BASIC line "[host or container]" already pins
the minimum). Expand the Claude Code update box by 8 chars and the
Project manifests box by 2 chars; the other two are untouched.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 .devcontainer/post-start.sh | 40 ++++++++++++++++++-------------------
 1 file changed, 20 insertions(+), 20 deletions(-)

diff --git a/.devcontainer/post-start.sh b/.devcontainer/post-start.sh
index 0ebd19c..2b4cd8a 100755
--- a/.devcontainer/post-start.sh
+++ b/.devcontainer/post-start.sh
@@ -152,14 +152,14 @@ check_claude_update() {
   [ -z "$latest" ] && return 0
   [ "$installed" = "$latest" ] && return 0
   printf '\033[1;33m'
-  printf '╔════════════════════════════════════════════════════════╗\n'
-  printf '║  ⚠  Claude Code update available                       ║\n'
-  printf '║     installed: %-40s║\n' "$installed"
-  printf '║     latest:    %-40s║\n' "$latest"
-  printf '║                                                        ║\n'
-  printf '║  Bump CLAUDE_CODE_VERSION in .devcontainer/.env then   ║\n'
-  printf '║  "Dev Containers: Rebuild Container" in VS Code.       ║\n'
-  printf '╚════════════════════════════════════════════════════════╝\n'
+  printf '╔════════════════════════════════════════════════════════════════╗\n'
+  printf '║  ⚠  Claude Code update available                               ║\n'
+  printf '║     installed: %-48s║\n' "$installed"
+  printf '║     latest:    %-48s║\n' "$latest"
+  printf '║                                                                ║\n'
+  printf '║  Bump CLAUDE_CODE_VERSION in .devcontainer/.env then           ║\n'
+  printf '║  "Dev Containers: Rebuild Container" in VS Code.               ║\n'
+  printf '╚════════════════════════════════════════════════════════════════╝\n'
   printf '\033[0m'
 }
 check_claude_update
@@ -216,18 +216,18 @@ if stale:
     yellow = '\033[1;33m'
     reset = '\033[0m'
     lines = [
-        '╔══════════════════════════════════════════════════════════════╗',
-        '║  ⚠  Project manifests changed since last firewall extract    ║',
-        '║                                                              ║',
-        '║  Refresh the allowlist (deterministic, no AI) :              ║',
-        '║     bash .devcontainer/skills/scan-deps/                     ║',
-        '║          extract-auto-dependencies                           ║',
-        '║                                                              ║',
-        '║  Then reload the firewall :                                  ║',
-        '║     sudo /usr/local/bin/init-firewall.sh                     ║',
-        '║                                                              ║',
-        '║  Or run /scan-deps in Claude for review + edge cases.        ║',
-        '╚══════════════════════════════════════════════════════════════╝',
+        '╔════════════════════════════════════════════════════════════════╗',
+        '║  ⚠  Project manifests changed since last firewall extract      ║',
+        '║                                                                ║',
+        '║  Refresh the allowlist (deterministic, no AI) :                ║',
+        '║     bash .devcontainer/skills/scan-deps/                       ║',
+        '║          extract-auto-dependencies                             ║',
+        '║                                                                ║',
+        '║  Then reload the firewall :                                    ║',
+        '║     sudo /usr/local/bin/init-firewall.sh                       ║',
+        '║                                                                ║',
+        '║  Or run /scan-deps in Claude for review + edge cases.          ║',
+        '╚════════════════════════════════════════════════════════════════╝',
     ]
     print(yellow + '\n'.join(lines) + reset)
 PY
