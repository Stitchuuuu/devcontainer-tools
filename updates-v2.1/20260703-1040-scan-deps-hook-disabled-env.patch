diff --git a/.devcontainer/.env.example b/.devcontainer/.env.example
index 6ca3a7a..8ba248e 100644
--- a/.devcontainer/.env.example
+++ b/.devcontainer/.env.example
@@ -61,6 +61,14 @@
 #NOTIFY_CLEANUP_MAX_AGE_HOURS=24
 
 
+# === scan-deps ===============================================================
+# SessionStart hook (.devcontainer/skills/scan-deps/scan-deps-suggest-stale.sh)
+# injects a banner when project manifests are newer than firewall/domains.d/<eco>.txt,
+# nudging Claude to propose /scan-deps. Uncomment to silence the nudge for the
+# whole session — the /scan-deps skill remains invokable on demand.
+#SCAN_DEPS_HOOK_DISABLED=1
+
+
 # === Firewall ================================================================
 # Mode source of truth = /workspace/.devcontainer/.configured-firewall-mode
 #   off     = no filter (direct internet, emergency kill-switch)
diff --git a/.devcontainer/post-start.sh b/.devcontainer/post-start.sh
index 2b4cd8a..144538c 100644
--- a/.devcontainer/post-start.sh
+++ b/.devcontainer/post-start.sh
@@ -168,7 +168,7 @@ check_claude_update
 # last `extract-auto-dependencies` run. Compares per-manifest mtime against
 # the matching `domains.d/<eco>.txt` mtime (the deterministic allowlist file
 # generated by extract-auto). If stale, suggest re-running the extractor.
-if command -v python3 >/dev/null 2>&1; then
+if [ -z "${SCAN_DEPS_HOOK_DISABLED:-}" ] && command -v python3 >/dev/null 2>&1; then
   python3 - <<'PY' || true
 import os, subprocess
 DOMAINS_D = '/workspace/.devcontainer/firewall/domains.d'
diff --git a/.devcontainer/shell-init.sh b/.devcontainer/shell-init.sh
index c882a26..990bf91 100644
--- a/.devcontainer/shell-init.sh
+++ b/.devcontainer/shell-init.sh
@@ -154,7 +154,7 @@ if [[ $- == *i* ]]; then
   # is newer than its corresponding `domains.d/npm.txt`. Mirrors the loud
   # yellow ASCII box shown once per container start in post-start.sh — but
   # quieter, refreshed every shell open.
-  if command -v python3 >/dev/null 2>&1; then
+  if [ -z "${SCAN_DEPS_HOOK_DISABLED:-}" ] && command -v python3 >/dev/null 2>&1; then
     python3 - <<'PY' 2>/dev/null || true
 import os, subprocess
 DOMAINS_D = '/workspace/.devcontainer/firewall/domains.d'
diff --git a/.devcontainer/skills/scan-deps/scan-deps-suggest-stale.sh b/.devcontainer/skills/scan-deps/scan-deps-suggest-stale.sh
index b90a895..3f1a220 100755
--- a/.devcontainer/skills/scan-deps/scan-deps-suggest-stale.sh
+++ b/.devcontainer/skills/scan-deps/scan-deps-suggest-stale.sh
@@ -24,6 +24,9 @@
 
 set -uo pipefail
 
+# Opt-out via .devcontainer/.env (docker-compose loads it as env_file) — any
+# non-empty value silences the nudge ; /scan-deps stays invokable on demand.
+[ -n "${SCAN_DEPS_HOOK_DISABLED:-}" ] && exit 0
 command -v python3 >/dev/null 2>&1 || exit 0
 
 stale=$(python3 << 'PY'
